:root {
  /* Core palette — tuned in oklch for consistent luminance. */
  --bg-core:        #000000;       /* OLED true-black */
  --bg-wine-a:      #0A0006;
  --bg-wine-b:      #120010;
  --panel-glass:    rgba(180, 130, 160, 0.06);
  --text-pearl:     #F4E8EA;
  --text-mauve:     #9A8087;
  --accent-berry:   #B47491;
  --accent-rose:    #E5B8C5;
  --accent-lav:     #C9A5D4;
  --accent-champ:   #E8D4A8;
  --accent-ember:   #C96A7A;   /* error — rose-red within the same family */

  /* Motion */
  --silk: cubic-bezier(0.22, 1, 0.36, 1);

  /* User-tweakable */
  --motion-speed: 1;
  --breath-amp: 1;
  --density: 1;
  --warmth: 0.6;
  --accent-hue-shift: 0deg;
}

* { box-sizing: border-box; }

/* Pearl-thread scrollbars — apply globally so they win over any host UA defaults. */
*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
*::-webkit-scrollbar-track {
  background: transparent;
}
*::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(229, 184, 197, 0.32), rgba(180, 116, 145, 0.28));
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
  min-height: 36px;
}
*::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgba(229, 184, 197, 0.55), rgba(201, 165, 212, 0.5));
  background-clip: padding-box;
  border: 2px solid transparent;
}
*::-webkit-scrollbar-corner { background: transparent; }
*::-webkit-scrollbar-button { display: none; height: 0; width: 0; }
html { scrollbar-width: thin; scrollbar-color: rgba(229, 184, 197, 0.35) transparent; }
* { scrollbar-width: thin; scrollbar-color: rgba(229, 184, 197, 0.35) transparent; }

html, body {
  margin: 0; padding: 0;
  background: var(--bg-core);
  color: var(--text-pearl);
  font-family: 'Newsreader', 'Fraunces', serif;
  font-optical-sizing: auto;
  overflow: hidden;
  height: 100%;
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

/* ═══════════════════════════════════════════════════════════════
   APP SHELL — frameless rounded-rect window with thin pearl rim
   ═══════════════════════════════════════════════════════════════ */

.app-viewport {
  position: fixed; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background:
    radial-gradient(ellipse at 50% 55%, #06000A 0%, #000000 70%);
  padding: 28px;
}

.app-window {
  position: relative;
  width: min(1180px, 100%);
  height: min(720px, 100%);
  border-radius: 22px;
  overflow: hidden;
  background: var(--bg-core);
  isolation: isolate;
  box-shadow:
    0 40px 120px -20px rgba(180, 100, 140, 0.35),
    0 12px 40px -8px rgba(0, 0, 0, 0.8),
    inset 0 0 0 1px rgba(229, 184, 197, 0.08);
}

/* Window rim glow. The previous spinning conic-gradient rim was visible
   as diagonal pearl streaks crossing the interior — the mask trick that
   was supposed to clip it to a 1.2px ring leaks the gradient's seam line
   into the content area, especially along the conic's start/end angle.
   Replaced with a static inset hairline. The pearl identity already lives
   on each glass panel's rim cycle (.glass-rim-*), so the window border
   doesn't need to compete. */
.app-window::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.16);
  pointer-events: none;
  z-index: 10;
}

.app-window::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 80px -20px rgba(180, 100, 140, 0.15);
  pointer-events: none;
  z-index: 11;
}

/* ═══════════════════════════════════════════════════════════════
   BACKDROP — velvet folds + caustics + bokeh + petals + dust
   ═══════════════════════════════════════════════════════════════ */

.backdrop {
  position: absolute; inset: 0;
  overflow: hidden;
  /* isolation forms a new stacking context so the mix-blend-mode children
     (velvet folds, caustics, bokeh, pearl dust) are confined here and don't
     leak across into the panel layer above. Without this, screen-blend
     children blend with everything beneath them in the parent's stacking
     context — including, in some browsers, content that visually sits on
     top of the backdrop. */
  isolation: isolate;
  background:
    radial-gradient(ellipse at 35% 40%, var(--bg-wine-b) 0%, var(--bg-wine-a) 45%, #000 80%);
  z-index: 0;
}

/* Velvet folds */
.vf-root { position: absolute; inset: 0; }
.vf-turb { position: absolute; width: 0; height: 0; }
.vf-layer {
  position: absolute; inset: -20%;
  filter: blur(40px) url(#vfTurb);
  animation: fold-drift 22s ease-in-out infinite alternate;
  mix-blend-mode: screen;
  opacity: 0.85;
}
.vf-b { animation-delay: -8s; animation-duration: 28s; }
.vf-c { animation-delay: -14s; animation-duration: 34s; opacity: 0.6; }

@keyframes fold-drift {
  0%   { transform: translate(-3%, -2%) scale(1.08) rotate(-1deg); }
  50%  { transform: translate(2%, 3%) scale(1.12) rotate(0.5deg); }
  100% { transform: translate(-2%, -3%) scale(1.06) rotate(-0.5deg); }
}

.vf-vignette {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 50% 60%, transparent 30%, rgba(0,0,0,0.65) 85%);
  pointer-events: none;
}

/* Caustics — slow iridescent light-on-silk */
.caustics {
  position: absolute; inset: 0;
  mix-blend-mode: screen;
  pointer-events: none;
}
.caustics-layer {
  position: absolute; inset: -20%;
  background:
    radial-gradient(40% 30% at 20% 30%, oklch(0.85 0.06 340 / 0.12), transparent 60%),
    radial-gradient(30% 40% at 70% 60%, oklch(0.82 0.08 300 / 0.1), transparent 60%),
    radial-gradient(35% 35% at 50% 80%, oklch(0.88 0.05 45 / 0.08), transparent 60%);
  filter: blur(30px);
  animation: caustic-drift 38s linear infinite;
}
.caustics-layer-b {
  background:
    radial-gradient(35% 40% at 80% 20%, oklch(0.84 0.07 320 / 0.1), transparent 60%),
    radial-gradient(40% 30% at 30% 70%, oklch(0.86 0.06 25 / 0.08), transparent 60%);
  animation-duration: 52s;
  animation-direction: reverse;
}
@keyframes caustic-drift {
  to { transform: translate(3%, -4%) rotate(6deg); }
}

/* Bokeh orb — softer + smaller so the per-frame blur cost is bearable.
   60px blur on an 80vmin element was the single biggest CSS perf hog;
   the orb still reads as a massive soft pearl at 50vmin / blur(40px) but
   now the GPU can keep up at full framerate. */
.bokeh-orb {
  position: absolute;
  width: 50vmin; height: 50vmin;
  top: 30%; left: -25%;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.4;
  mix-blend-mode: screen;
  animation: bokeh-cross 60s linear infinite;
  pointer-events: none;
}
@keyframes bokeh-cross {
  0%   { transform: translate(-20%, -10%) scale(1); opacity: 0; }
  15%  { opacity: 0.35; }
  50%  { transform: translate(60%, 20%) scale(1.2); opacity: 0.45; }
  85%  { opacity: 0.3; }
  100% { transform: translate(140%, -5%) scale(0.9); opacity: 0; }
}

/* Pearl dust canvas */
.pearl-dust {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  mix-blend-mode: screen;
}

/* Petals canvas */
.petals {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}

/* Celebrate brightness lift */
.app-window.celebrating .backdrop {
  filter: brightness(1.15) saturate(1.08);
  transition: filter 400ms cubic-bezier(0.22, 1, 0.36, 1);
}
.app-window:not(.celebrating) .backdrop {
  transition: filter 800ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* ═══════════════════════════════════════════════════════════════
   GLASS PANEL
   ═══════════════════════════════════════════════════════════════ */

.glass-panel {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  isolation: isolate;
  opacity: 1;
  /* Hairline rim drawn on the panel itself so the rounded corner is honored
     by the same element that sets border-radius. Inner layers no longer
     paint a rim — that produced visible square offsets at the corners. */
  box-shadow: inset 0 0 0 0.5px rgba(229, 184, 197, 0.18);
}
.glass-panel.mounted { opacity: 1; }

.glass-refract {
  position: absolute; inset: 0;
  border-radius: inherit;
  /* Blur 32px (was bumped 28→40 to mask z-order leaks; 40 was costly enough
     across multiple panels to drag framerate down). With backdrop isolation
     now handling the leak properly, 32 + the higher tint opacity is enough
     to obscure backdrop content without paying for the full 40. */
  backdrop-filter: blur(32px) saturate(1.45);
  -webkit-backdrop-filter: blur(32px) saturate(1.45);
  background: rgba(28, 10, 20, 0.52);
  z-index: 0;
}

.glass-tint {
  position: absolute; inset: 0;
  border-radius: inherit;
  /* Tint alphas bumped (~2x). The original 0.05–0.09 range left the panel
     too transparent — backdrop content was readable through it. Higher tint
     keeps the pearlescent character but commits the panel as foreground. */
  background:
    linear-gradient(135deg,
      rgba(229, 184, 197, 0.18) 0%,
      rgba(180, 116, 145, 0.12) 40%,
      rgba(201, 165, 212, 0.16) 100%),
    radial-gradient(120% 80% at 50% -20%, rgba(244, 232, 234, 0.14), transparent 60%);
  z-index: 1;
  pointer-events: none;
}

.glass-panel.breathing {
  /* Breath is delegated to the .glass-tint layer (no text content there)
     so we never sub-pixel-scale the panel itself. Scaling the panel forces
     subpixel-misaligned rasterization of every glyph it contains, which
     visibly softens text on dense surfaces like the launching log. */
}
.glass-panel.breathing > .glass-tint {
  animation: breath-tint calc(8s / var(--motion-speed)) ease-in-out infinite;
}
.glass-panel.mount-in {
  animation: panel-mount 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
.glass-panel.mount-in > .glass-tint {
  animation: breath-tint calc(8s / var(--motion-speed)) ease-in-out 900ms infinite;
}
@keyframes panel-mount {
  0%   { opacity: 0; transform: scale(0.98); filter: blur(8px); }
  100% { opacity: 1; transform: scale(1); filter: blur(0); }
}
@keyframes breath-tint {
  /* Subtle opacity pulse on the tint layer reads as the panel "breathing"
     without touching its geometry. Amplitude wired to --breath-amp so the
     dev tweak panel still controls how strong it feels. */
  0%, 100% { opacity: 1; }
  50%      { opacity: calc(1 - 0.10 * var(--breath-amp)); }
}

.glass-inner {
  position: relative;
  z-index: 4;
}

/* The launching log panel constrains its height via the parent grid
   (row 1fr in .screen-launching). For the inner <ol> to actually
   overflow + scroll, the wrapping .glass-inner must propagate that
   height down + lay out as a flex column so the head stays put and
   the log fills the remaining space. Without these declarations
   .glass-inner is content-sized and its overflow:auto child never
   has a smaller-than-content viewport to scroll inside. */
.launching-log-panel > .glass-inner {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  height: 100%;
}

/* Four iridescent rim lights, one per edge, cycling async */
.glass-rim {
  position: absolute;
  z-index: 3;
  pointer-events: none;
  filter: blur(1px);
  opacity: 0.85;
}
.glass-rim-top {
  top: 0; left: 0; right: 0; height: 1.5px;
  background: linear-gradient(90deg,
    transparent, var(--accent-rose), var(--accent-lav), var(--accent-champ), var(--accent-rose), transparent);
  background-size: 240% 100%;
  animation: rim-slide calc(12s / var(--motion-speed)) linear infinite;
}
.glass-rim-right {
  top: 0; bottom: 0; right: 0; width: 1.5px;
  background: linear-gradient(180deg,
    transparent, var(--accent-champ), var(--accent-rose), var(--accent-lav), var(--accent-champ), transparent);
  background-size: 100% 240%;
  animation: rim-slide-v calc(12s / var(--motion-speed)) linear infinite;
  animation-delay: calc(-3s / var(--motion-speed));
}
.glass-rim-bottom {
  bottom: 0; left: 0; right: 0; height: 1.5px;
  background: linear-gradient(90deg,
    transparent, var(--accent-lav), var(--accent-champ), var(--accent-rose), var(--accent-lav), transparent);
  background-size: 240% 100%;
  animation: rim-slide calc(12s / var(--motion-speed)) linear infinite;
  animation-delay: calc(-6s / var(--motion-speed));
}
.glass-rim-left {
  top: 0; bottom: 0; left: 0; width: 1.5px;
  background: linear-gradient(180deg,
    transparent, var(--accent-rose), var(--accent-champ), var(--accent-lav), var(--accent-rose), transparent);
  background-size: 100% 240%;
  animation: rim-slide-v calc(12s / var(--motion-speed)) linear infinite;
  animation-delay: calc(-9s / var(--motion-speed));
}
@keyframes rim-slide   { to { background-position: 240% 0; } }
@keyframes rim-slide-v { to { background-position: 0 240%; } }

/* ═══════════════════════════════════════════════════════════════
   BREATHING TEXT
   ═══════════════════════════════════════════════════════════════ */

.bt {
  display: inline-block;
  white-space: pre-wrap;
}
.bt-g {
  display: inline-block;
  letter-spacing: 0;
  animation: bt-breath calc(8s / var(--motion-speed)) ease-in-out infinite;
  will-change: letter-spacing;
}
@keyframes bt-breath {
  0%, 100% { letter-spacing: 0em; }
  50%      { letter-spacing: 0.02em; }
}

.bt-sheen {
  background-image: linear-gradient(100deg,
    #F4E8EA 0%,
    #F4E8EA 40%,
    #FFF6F0 48%,
    #FFFFFF 50%,
    #FFF6F0 52%,
    #F4E8EA 60%,
    #F4E8EA 100%);
  background-size: 200% 100%;
  background-repeat: repeat-x;
  background-position: 100% 0;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: bt-sheen-sweep calc(4s / var(--motion-speed)) linear infinite;
}
@keyframes bt-sheen-sweep {
  0%   { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.bt-hover-glow .bt-g {
  transition: text-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1), color 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.bt-hover-glow:hover .bt-g {
  color: #FFF0F4;
  text-shadow:
    0 0 8px rgba(229, 184, 197, 0.65),
    0 0 18px rgba(180, 116, 145, 0.35);
}
.bt-hover-glow:hover .bt-g:nth-child(2n)  { transition-delay: 30ms; }
.bt-hover-glow:hover .bt-g:nth-child(3n)  { transition-delay: 60ms; }
.bt-hover-glow:hover .bt-g:nth-child(4n)  { transition-delay: 90ms; }
.bt-hover-glow:hover .bt-g:nth-child(5n)  { transition-delay: 120ms; }

/* ═══════════════════════════════════════════════════════════════
   BUTTON
   ═══════════════════════════════════════════════════════════════ */

.vbtn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center;
  gap: 10px;
  padding: 14px 26px;
  border: 0; outline: 0;
  background: transparent;
  color: var(--text-pearl);
  font-family: 'Newsreader', serif;
  font-size: 16px;
  font-weight: 400;
  letter-spacing: 0.02em;
  border-radius: 14px;
  cursor: pointer;
  overflow: hidden;
  isolation: isolate;
  transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.vbtn-tint {
  position: absolute; inset: 0;
  background:
    linear-gradient(135deg,
      rgba(229, 184, 197, 0.10),
      rgba(180, 116, 145, 0.06) 40%,
      rgba(201, 165, 212, 0.08) 100%);
  backdrop-filter: blur(14px) saturate(1.2);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  z-index: -2;
  border-radius: inherit;
}

.vbtn-rim {
  position: absolute; inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg,
    rgba(229, 184, 197, 0.55),
    rgba(201, 165, 212, 0.25) 50%,
    rgba(232, 212, 168, 0.45));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude;
  z-index: -1;
  animation: vbtn-rim-pulse calc(7s / var(--motion-speed)) ease-in-out infinite;
}
@keyframes vbtn-rim-pulse {
  0%, 100% { opacity: 0.7; }
  50%      { opacity: 1; }
}

.vbtn-sheen {
  position: absolute;
  top: 0; bottom: 0;
  left: -40%; width: 40%;
  background: linear-gradient(100deg,
    transparent 30%,
    rgba(255, 240, 244, 0.18) 48%,
    rgba(229, 184, 197, 0.35) 50%,
    rgba(255, 240, 244, 0.18) 52%,
    transparent 70%);
  filter: blur(2px);
  transform: skewX(-18deg);
  z-index: -1;
  animation: vbtn-sheen-sweep calc(7s / var(--motion-speed)) linear infinite;
}
@keyframes vbtn-sheen-sweep {
  0%   { left: -40%; }
  100% { left: 110%; }
}

.vbtn:hover {
  transform: translateY(-0.5px);
}
.vbtn:hover .vbtn-sheen {
  animation-duration: calc(2.5s / var(--motion-speed));
}
.vbtn:hover .vbtn-rim {
  animation-duration: calc(2s / var(--motion-speed));
  opacity: 1;
  background: linear-gradient(135deg,
    rgba(229, 184, 197, 0.8),
    rgba(201, 165, 212, 0.45) 50%,
    rgba(232, 212, 168, 0.7));
}

.vbtn.pressing {
  transform: scale(0.96);
  transition-duration: 180ms;
}

.vbtn.primary .vbtn-tint {
  background:
    linear-gradient(135deg,
      rgba(229, 184, 197, 0.18),
      rgba(180, 116, 145, 0.14) 40%,
      rgba(201, 165, 212, 0.16) 100%);
}
.vbtn.primary {
  padding: 16px 32px;
  font-size: 17px;
}

.vbtn.disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* running indicator — subtle pearl comet orbiting the border */
.vbtn-running {
  position: absolute; inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background:
    conic-gradient(from 0deg,
      transparent 0deg,
      transparent 340deg,
      rgba(229, 184, 197, 0.9) 350deg,
      #FFF0F4 360deg,
      transparent 370deg);
  -webkit-mask: radial-gradient(circle, transparent 55%, #000 56%);
  animation: rim-spin 2.2s linear infinite;
  opacity: 0.8;
  filter: blur(0.5px);
}

/* press ripple */
.vbtn-ripple {
  position: absolute;
  width: 6px; height: 6px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle,
    rgba(255, 225, 230, 0.8) 0%,
    rgba(229, 184, 197, 0.4) 40%,
    transparent 70%);
  animation: vbtn-ripple 620ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
  z-index: 2;
}
@keyframes vbtn-ripple {
  0%   { width: 6px; height: 6px; opacity: 0.9; }
  100% { width: 320px; height: 320px; opacity: 0; }
}

/* cursor pearl specks */
.vbtn-speck {
  position: absolute;
  width: 4px; height: 4px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle,
    oklch(0.95 0.08 var(--speck-hue) / 0.9) 0%,
    oklch(0.82 0.1 var(--speck-hue) / 0.4) 50%,
    transparent 80%);
  animation: vbtn-speck 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
  z-index: 3;
  filter: blur(0.3px);
}
@keyframes vbtn-speck {
  0%   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -90%) scale(0.4); }
}

/* ═══════════════════════════════════════════════════════════════
   PROGRESS BAR
   ═══════════════════════════════════════════════════════════════ */

.pbar {
  position: relative;
  width: 100%;
  height: 2px;
  border-radius: 999px;
}
.pbar-track {
  position: absolute; inset: 0;
  border-radius: inherit;
  background: linear-gradient(90deg,
    rgba(229, 184, 197, 0.08),
    rgba(201, 165, 212, 0.12),
    rgba(229, 184, 197, 0.08));
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.12);
}
.pbar-fill {
  position: absolute;
  top: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(90deg,
    #D4A8B8 0%,
    #E5B8C5 30%,
    #F4D4DE 50%,
    #E5B8C5 70%,
    #C9A5D4 100%);
  transition: width 400ms cubic-bezier(0.22, 1, 0.36, 1), background 600ms cubic-bezier(0.22, 1, 0.36, 1);
  overflow: visible;
}
.pbar-flow {
  position: absolute; inset: 0;
  border-radius: inherit;
  background:
    linear-gradient(90deg,
      transparent 0%,
      rgba(255, 240, 244, 0.35) 30%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(255, 240, 244, 0.35) 70%,
      transparent 100%);
  background-size: 40% 100%;
  background-repeat: no-repeat;
  animation: pbar-flow calc(3s / var(--motion-speed)) linear infinite;
  mix-blend-mode: screen;
}
@keyframes pbar-flow {
  0%   { background-position: -40% 0; }
  100% { background-position: 140% 0; }
}
.pbar-bloom {
  position: absolute;
  top: -4px; bottom: -4px;
  right: -6px;
  width: 14px;
  background: radial-gradient(ellipse at center,
    rgba(255, 230, 238, 0.9) 0%,
    rgba(229, 184, 197, 0.4) 40%,
    transparent 80%);
  filter: blur(3px);
  pointer-events: none;
}

/* Complete state */
.pbar-state-complete .pbar-fill {
  background: linear-gradient(90deg,
    #E5B8C5 0%, #F4D4DE 40%, #E8D4A8 80%, #E5B8C5 100%);
  box-shadow: 0 0 12px rgba(229, 184, 197, 0.45);
}
.pbar-ring {
  position: absolute;
  left: 100%;
  top: 50%;
  width: 4px; height: 4px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(229, 184, 197, 0.8);
  animation: pbar-ring 1400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
}
@keyframes pbar-ring {
  0%   { width: 4px;   height: 4px;   opacity: 0.9; border-width: 2px; }
  100% { width: 320px; height: 320px; opacity: 0;   border-width: 1px; }
}

/* Error state — variants */
.pbar-state-error.pbar-err-rose .pbar-fill {
  background: linear-gradient(90deg,
    #A35A6C 0%, #C96A7A 50%, #D4889A 100%);
  box-shadow: 0 0 8px rgba(201, 106, 122, 0.4);
}
.pbar-state-error.pbar-err-rose .pbar-flow {
  opacity: 0.35;
  animation-duration: calc(8s / var(--motion-speed));
}

.pbar-state-error.pbar-err-recede .pbar-fill {
  animation: pbar-recede 1200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes pbar-recede {
  to { width: 0; }
}
.pbar-state-error.pbar-err-recede .pbar-track {
  background: linear-gradient(90deg,
    rgba(201, 106, 122, 0.15),
    rgba(229, 184, 197, 0.1),
    rgba(201, 106, 122, 0.15));
}
.pbar-err-shimmer {
  position: absolute; inset: 0;
  border-radius: inherit;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(201, 106, 122, 0.5) 48%,
    rgba(244, 232, 234, 0.6) 50%,
    rgba(201, 106, 122, 0.5) 52%,
    transparent 100%);
  background-size: 30% 100%;
  background-repeat: no-repeat;
  animation: pbar-err-shim 1400ms cubic-bezier(0.22, 1, 0.36, 1) infinite;
  mix-blend-mode: screen;
}
@keyframes pbar-err-shim {
  0%   { background-position: -30% 0; opacity: 0; }
  20%  { opacity: 1; }
  100% { background-position: 130% 0; opacity: 0; }
}

.pbar-state-error.pbar-err-fracture .pbar-fill {
  background: linear-gradient(90deg,
    #C8A4B4 0%, #B47491 50%, #8A6E7E 100%);
  filter: saturate(0.8);
}
.pbar-fracture {
  position: absolute;
  top: -6px; bottom: -6px;
  width: 1px;
  transform: translateX(-50%);
  background: linear-gradient(180deg,
    transparent,
    #E5B8C5 20%,
    #F4D4DE 50%,
    #C9A5D4 80%,
    transparent);
  filter: blur(0.5px);
  box-shadow: 0 0 6px rgba(229, 184, 197, 0.8);
  animation: pbar-frac-shim 2s ease-in-out infinite;
}
@keyframes pbar-frac-shim {
  0%, 100% { opacity: 0.6; transform: translateX(-50%) scaleY(1); }
  50%      { opacity: 1;   transform: translateX(-50%) scaleY(1.08); }
}

/* Celebrating state — all progress bars brighten */
.app-window.celebrating .pbar-state-complete .pbar-fill {
  filter: brightness(1.2);
}

/* ═══════════════════════════════════════════════════════════════
   SLIDER
   ═══════════════════════════════════════════════════════════════ */

.vslider {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.vslider-label {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-mauve);
  font-family: 'JetBrains Mono', monospace;
  font-weight: 400;
}
.vslider-row {
  position: relative;
  padding: 12px 6px;
}
.vslider-track {
  position: relative;
  width: 100%; height: 2px;
  border-radius: 999px;
  background: linear-gradient(90deg,
    rgba(229, 184, 197, 0.1),
    rgba(201, 165, 212, 0.15),
    rgba(229, 184, 197, 0.1));
  cursor: pointer;
}
.vslider-fill {
  position: absolute; top: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #D4A8B8, #E5B8C5 50%, #C9A5D4);
  overflow: visible;
}
.vslider-handle {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 14px; height: 14px;
  pointer-events: none;
}
.vslider-halo {
  position: absolute; inset: -10px;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(255, 230, 238, 0.55) 0%,
    rgba(229, 184, 197, 0.2) 40%,
    transparent 75%);
  filter: blur(4px);
  animation: firefly calc(3s / var(--motion-speed)) ease-in-out infinite;
}
@keyframes firefly {
  0%, 100% { opacity: 0.65; transform: scale(1); }
  50%      { opacity: 1;    transform: scale(1.15); }
}
.vslider-core {
  position: absolute; inset: 3px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%,
    #FFF0F4 0%, #E5B8C5 50%, #B47491 100%);
  box-shadow:
    0 0 6px rgba(229, 184, 197, 0.9),
    inset 0 0 0 0.5px rgba(255, 255, 255, 0.4);
}
.vslider-trail {
  position: absolute; top: 50%;
  transform: translate(-50%, -50%);
  width: 4px; height: 4px;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF0F4, transparent 70%);
  animation: vslider-trail 500ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
}
@keyframes vslider-trail {
  to { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
}
.vslider-value {
  position: absolute;
  bottom: calc(100% + 4px);
  transform: translateX(-50%);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--text-pearl);
  background: rgba(10, 0, 6, 0.7);
  border: 1px solid rgba(229, 184, 197, 0.3);
  border-radius: 6px;
  padding: 3px 8px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  animation: vslider-val-in 300ms cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
  white-space: nowrap;
}
@keyframes vslider-val-in {
  from { opacity: 0; transform: translate(-50%, 4px); }
  to   { opacity: 1; transform: translate(-50%, 0); }
}

/* ═══════════════════════════════════════════════════════════════
   DROPDOWN
   ═══════════════════════════════════════════════════════════════ */

.vdrop { position: relative; display: flex; flex-direction: column; gap: 6px; }
.vdrop-label {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-mauve);
  font-family: 'JetBrains Mono', monospace;
}
.vdrop-head {
  justify-content: space-between;
  padding: 10px 16px;
  font-size: 14px;
  min-width: 160px;
}
.vdrop-caret {
  width: 6px; height: 6px;
  border-right: 1px solid var(--text-pearl);
  border-bottom: 1px solid var(--text-pearl);
  transform: rotate(45deg) translate(-2px, -2px);
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  opacity: 0.7;
}
.vdrop.open .vdrop-caret {
  transform: rotate(-135deg) translate(-2px, -2px);
}
.vdrop-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0; right: 0;
  z-index: 50;
  min-width: 220px;
}
.vdrop-panel {
  padding: 6px;
}

/* Portaled dropdown menu — fixed-positioned, opaque so it never bleeds. */
.vdrop-portal-menu {
  pointer-events: auto;
  animation: vdrop-portal-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  transform-origin: top center;
}
@keyframes vdrop-portal-in {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); filter: blur(4px); }
  to   { opacity: 1; transform: translateY(0)    scale(1);    filter: blur(0); }
}
.vdrop-portal-menu.flip-up {
  transform-origin: bottom center;
  animation-name: vdrop-portal-in-up;
}
@keyframes vdrop-portal-in-up {
  from { opacity: 0; transform: translateY(-100%) translateY(4px) scale(0.98); filter: blur(4px); }
  to   { opacity: 1; transform: translateY(-100%) translateY(0)    scale(1);    filter: blur(0); }
}
.vdrop-panel-solid {
  position: relative;
  padding: 6px;
  border-radius: 14px;
  background:
    linear-gradient(180deg,
      rgba(38, 18, 30, 0.96) 0%,
      rgba(28, 12, 22, 0.97) 100%);
  backdrop-filter: blur(32px) saturate(1.5);
  -webkit-backdrop-filter: blur(32px) saturate(1.5);
  box-shadow:
    inset 0 0 0 1px rgba(229, 184, 197, 0.16),
    inset 0 1px 0 rgba(244, 232, 234, 0.06),
    0 18px 48px rgba(0, 0, 0, 0.6),
    0 4px 16px rgba(0, 0, 0, 0.4),
    0 0 32px rgba(180, 116, 145, 0.12);
  overflow: hidden;
  isolation: isolate;
  max-height: 60vh;
  overflow-y: auto;
}
.vdrop-panel-solid::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(120% 80% at 50% -10%, rgba(229, 184, 197, 0.10), transparent 60%);
  pointer-events: none;
  z-index: 0;
}
.vdrop-panel-solid > .vdrop-row {
  position: relative;
  z-index: 1;
}
.vdrop-row {
  display: flex; align-items: center; gap: 10px;
  width: 100%;
  padding: 10px 12px;
  background: transparent;
  border: 0;
  color: var(--text-pearl);
  font-family: 'Newsreader', serif;
  font-size: 14px;
  text-align: left;
  cursor: pointer;
  border-radius: 10px;
  position: relative;
  opacity: 0;
  transform: translateY(-4px);
  animation: vdrop-row-in 400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: calc(var(--row-i) * 50ms);
  transition: background 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.vdrop-row + .vdrop-row::before {
  content: '';
  position: absolute;
  top: 0; left: 8px; right: 8px;
  height: 1px;
  background: linear-gradient(90deg,
    transparent, rgba(229, 184, 197, 0.2) 50%, transparent);
}
@keyframes vdrop-row-in {
  from { opacity: 0; transform: translateY(-4px); filter: blur(3px); }
  to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
}
.vdrop-row:hover {
  background: rgba(229, 184, 197, 0.05);
}
.vdrop-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: radial-gradient(circle, #FFF0F4, #E5B8C5 70%);
  box-shadow: 0 0 6px rgba(229, 184, 197, 0.8);
  opacity: 0;
  transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.vdrop-row.selected .vdrop-dot { opacity: 1; }

/* ═══════════════════════════════════════════════════════════════
   STATUS LINE
   ═══════════════════════════════════════════════════════════════ */

.vstatus {
  position: relative;
  min-height: 1.6em;
  font-size: 16px;
  font-style: italic;
  font-family: 'Newsreader', serif;
  color: var(--text-mauve);
  letter-spacing: 0.01em;
}
.vstatus-tone-pearl { color: var(--text-pearl); }
.vstatus-tone-error { color: #D4889A; }
.vstatus-tone-warm  { color: #E8D4A8; }

.vstatus-layer {
  display: block;
  position: relative;
}
.vstatus-in {
  animation: status-in 500ms cubic-bezier(0.22, 1, 0.36, 1);
}
.vstatus-out {
  position: absolute; inset: 0;
  animation: status-out 500ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
}
@keyframes status-in {
  from { opacity: 0; transform: translateY(8px); filter: blur(3px); }
  to   { opacity: 1; transform: translateY(0);   filter: blur(0); }
}
@keyframes status-out {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-10px); filter: blur(3px); }
}

/* ═══════════════════════════════════════════════════════════════
   LAUNCHER SCREEN
   ═══════════════════════════════════════════════════════════════ */

.launcher-stage {
  position: absolute; inset: 0;
  display: flex;
  z-index: 2;
  padding: 48px;
}

/* Column layout — spec */
.launcher-stage.layout-column {
  align-items: center;
  justify-content: center;
}
.layout-column .launcher-column {
  display: flex; flex-direction: column;
  gap: 18px;
  width: min(460px, 92%);
}

/* Asymmetric layout */
.launcher-stage.layout-asym { padding: 64px; }
.layout-asym .launcher-asym {
  width: 100%; height: 100%;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  grid-template-rows: 1fr auto;
  gap: 24px;
}
.layout-asym .asym-title-region {
  grid-column: 1; grid-row: 1;
  display: flex; align-items: flex-start;
  padding: 20px 0 0 8px;
}
.layout-asym .asym-controls-region {
  grid-column: 2; grid-row: 1 / 3;
  display: flex; align-items: flex-end; justify-content: flex-end;
}
.layout-asym .asym-controls-region .launcher-column {
  width: 100%; max-width: 380px;
}
.layout-asym .asym-status-region {
  grid-column: 1; grid-row: 2;
  display: flex; align-items: flex-end;
  padding: 0 0 8px 8px;
}

/* Horizontal layout — progress as spine */
.launcher-stage.layout-horiz {
  align-items: center; justify-content: center;
  padding: 80px 64px;
}
.layout-horiz .launcher-horiz {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 32px;
  align-items: center;
  width: 100%;
}
.layout-horiz .horiz-title {
  display: flex; flex-direction: column; gap: 6px;
}
.layout-horiz .horiz-progress-region {
  display: flex; flex-direction: column; gap: 14px;
}
.layout-horiz .horiz-controls {
  display: flex; gap: 12px;
}

/* Title */
.launcher-title {
  font-family: 'Fraunces', serif;
  font-optical-sizing: auto;
  font-variation-settings: "SOFT" 50, "WONK" 1;
  font-weight: 350;
  font-size: 52px;
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin: 0;
  color: var(--text-pearl);
}
.launcher-title .bt-g {
  animation-duration: calc(10s / var(--motion-speed)), 1.1s;
}

.launcher-subtitle {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--text-mauve);
  margin-top: 6px;
  opacity: 0.7;
}

.launcher-button-row {
  display: flex; gap: 12px; flex-wrap: wrap;
}

/* ═══════════════════════════════════════════════════════════════
   STATE PICKER
   ═══════════════════════════════════════════════════════════════ */

.state-picker {
  position: absolute;
  top: 20px; left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  display: flex; gap: 4px;
  padding: 4px;
  border-radius: 14px;
  background: rgba(10, 0, 6, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.18);
}
.state-picker button {
  border: 0; background: transparent;
  color: var(--text-mauve);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 8px 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.state-picker button:hover { color: var(--text-pearl); }
.state-picker button.active {
  color: var(--text-pearl);
  background: rgba(229, 184, 197, 0.12);
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.3);
}

/* Layout picker */
.layout-picker {
  position: absolute;
  bottom: 18px; left: 20px;
  z-index: 20;
  display: flex; gap: 4px;
  padding: 4px;
  border-radius: 14px;
  background: rgba(10, 0, 6, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.18);
}
.layout-picker button {
  border: 0; background: transparent;
  color: var(--text-mauve);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 8px 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.layout-picker button.active {
  color: var(--text-pearl);
  background: rgba(229, 184, 197, 0.12);
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.3);
}

/* Error-variant picker (only shown in error state) */
.error-picker {
  position: absolute;
  bottom: 18px;
  right: 20px;
  z-index: 20;
  display: flex; gap: 4px;
  padding: 4px;
  border-radius: 14px;
  background: rgba(10, 0, 6, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: inset 0 0 0 1px rgba(201, 106, 122, 0.3);
}
.error-picker button {
  border: 0; background: transparent;
  color: var(--text-mauve);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
  padding: 8px 12px;
  border-radius: 10px; cursor: pointer;
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.error-picker button.active {
  color: #F4E0E4;
  background: rgba(201, 106, 122, 0.2);
  box-shadow: inset 0 0 0 1px rgba(201, 106, 122, 0.5);
}

/* Meta pills — small informational chips */
.meta-pill {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-mauve);
  padding: 6px 10px;
  border-radius: 8px;
  background: rgba(229, 184, 197, 0.04);
  box-shadow: inset 0 0 0 1px rgba(229, 184, 197, 0.1);
}
.meta-pill .dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--accent-rose);
  box-shadow: 0 0 6px rgba(229, 184, 197, 0.9);
  animation: meta-pulse 2.4s ease-in-out infinite;
}
@keyframes meta-pulse {
  0%, 100% { opacity: 0.55; }
  50%      { opacity: 1; }
}

.meta-row {
  display: flex; gap: 8px; flex-wrap: wrap;
  margin-top: 4px;
}

/* Keyboard hint */
.kbd-hint {
  position: absolute;
  bottom: 18px; left: 50%;
  transform: translateX(-50%);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--text-mauve);
  opacity: 0.5;
  z-index: 15;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════
   TWEAKS PANEL OVERRIDES — match boudoir aesthetic
   ═══════════════════════════════════════════════════════════════ */

.tweaks-panel {
  background: rgba(10, 0, 6, 0.72) !important;
  border: 1px solid rgba(229, 184, 197, 0.2) !important;
  backdrop-filter: blur(20px) saturate(1.2);
  -webkit-backdrop-filter: blur(20px) saturate(1.2);
  color: var(--text-pearl) !important;
  font-family: 'Newsreader', serif !important;
}
.tweaks-panel h2, .tweaks-panel h3, .tweaks-panel label,
.tweaks-panel div, .tweaks-panel span {
  font-family: inherit !important;
  color: var(--text-pearl) !important;
}

/* ═══════════════════════════════════════════════════════════════
   ACCESSIBILITY / MOTION REDUCTION
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
