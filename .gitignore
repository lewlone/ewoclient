/target
**/*.rs.bk
Cargo.lock.bak

# IDE
/.vscode
/.idea
*.swp
*~

# Claude Code local session state
/.claude/

# OS
Thumbs.db
.DS_Store

# Profiling — local-only large files (excluded from public repo)
/perf.data*
*.profraw
Firefox*.json

# Local settings + auth state. The launcher writes these into
# %APPDATA%/EwoClient on Windows / $XDG_CONFIG_HOME/EwoClient on Linux,
# *not* into the repo — but list them here defensively in case future
# code ever puts them in the working tree.
/.env
/.cargo/.local
auth.toml
settings.toml
instances.toml
/dist/
__pycache__/

# Java oracle build output (tools/*_oracle/) — the .java is the artefact.
tools/**/*.class

# log4j's output, written relative to the CWD by anything that loads Minecraft's
# classes — which `tools/openal_loopback_oracle/` does, so re-running the M139
# capture leaves an (empty) logs/latest.log behind. Ignored because an untracked
# file makes a tree read as dirty, and several checks here treat "clean" as
# meaning "no leftover mutation".
/logs/
