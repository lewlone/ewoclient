/* ════════════════════════════════════════════════════════════════
   SETTINGS
   ════════════════════════════════════════════════════════════════ */
.screen-settings {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.settings-body {
  flex: 1;
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 36px;
  padding: 8px 60px 48px;
  min-height: 0;
}
.settings-tabs {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-top: 16px;
}
.settings-tabs-title {
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 32px;
  font-weight: 300;
  letter-spacing: -0.01em;
  color: #F4E8EA;
  margin-bottom: 28px;
  padding-left: 14px;
}
.settings-tab {
  position: relative;
  display: grid;
  grid-template-columns: 4px 1fr;
  gap: 14px;
  padding: 14px 14px 14px 0;
  background: transparent;
  border: 0;
  text-align: left;
  cursor: pointer;
  color: inherit;
  font-family: inherit;
  transition: padding-left 320ms cubic-bezier(0.22, 1, 0.36, 1);
}
.settings-tab:hover { padding-left: 8px; }
.settings-tab-mark {
  width: 4px;
  height: 18px;
  align-self: center;
  background: transparent;
  border-radius: 2px;
  transition: background 240ms, box-shadow 240ms;
}
.settings-tab-active .settings-tab-mark {
  background: linear-gradient(180deg, #E5B8C5, #C9A5D4);
  box-shadow: 0 0 10px rgba(229, 184, 197, 0.6);
}
.settings-tab-label {
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 18px;
  font-weight: 300;
  color: #9A8087;
  letter-spacing: -0.005em;
}
.settings-tab-active .settings-tab-label { color: #F4E8EA; }

.settings-detail {
  min-height: 0;
  overflow-y: auto;
  padding-top: 16px;
  padding-right: 8px;
}
.settings-panel { width: 100%; }
.settings-section {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.settings-section-head {
  margin-bottom: 28px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(229, 184, 197, 0.08);
}
.settings-h {
  margin: 0 0 6px;
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 32px;
  font-weight: 300;
  letter-spacing: -0.015em;
  color: #F4E8EA;
}
.settings-subhead {
  font-family: var(--body-font, 'Newsreader'), serif;
  font-style: italic;
  font-size: 14px;
  letter-spacing: 0.02em;
  color: #9A8087;
}
.settings-row {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 28px;
  align-items: center;
  padding: 18px 0;
  border-bottom: 1px solid rgba(229, 184, 197, 0.05);
}
.settings-row:last-child { border-bottom: 0; }
.settings-row-stack {
  grid-template-columns: 1fr;
  align-items: stretch;
  gap: 12px;
}
.settings-label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 16px;
  font-weight: 300;
  font-style: italic;
  color: #F4E8EA;
}
.settings-hint {
  font-family: var(--body-font, 'Newsreader'), serif;
  font-style: italic;
  font-size: 12px;
  letter-spacing: 0.02em;
  color: #6B555C;
}

/* Toggle */
.settings-toggle {
  position: relative;
  width: 44px;
  height: 22px;
  border-radius: 999px;
  background: rgba(229, 184, 197, 0.08);
  border: 1px solid rgba(229, 184, 197, 0.18);
  cursor: pointer;
  justify-self: end;
  transition: background 320ms, border-color 320ms, box-shadow 320ms;
  padding: 0;
}
.settings-toggle.on {
  background: rgba(229, 184, 197, 0.22);
  border-color: rgba(229, 184, 197, 0.45);
  box-shadow: 0 0 14px rgba(229, 184, 197, 0.28);
}
.settings-toggle:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
.settings-toggle-pearl {
  position: absolute;
  left: 2px; top: 50%;
  width: 16px; height: 16px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #FFF6F0, #E5B8C5 60%, #C8A4B4);
  transform: translateY(-50%);
  transition: left 320ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 320ms;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}
.settings-toggle.on .settings-toggle-pearl {
  left: calc(100% - 18px);
  box-shadow: 0 0 10px rgba(255, 246, 240, 0.7), 0 1px 4px rgba(0, 0, 0, 0.3);
}

/* Path field */
.settings-pathfield {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
}
.settings-pathinput {
  background: rgba(229, 184, 197, 0.04);
  border: 1px solid rgba(229, 184, 197, 0.14);
  border-radius: 8px;
  padding: 10px 14px;
  color: #F4E8EA;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 12px;
  letter-spacing: 0.02em;
  outline: none;
  transition: border-color 240ms, box-shadow 240ms;
}
.settings-pathinput:focus {
  border-color: rgba(229, 184, 197, 0.45);
  box-shadow: 0 0 0 3px rgba(229, 184, 197, 0.08);
}
.settings-pathbtn {
  background: transparent;
  border: 1px solid rgba(229, 184, 197, 0.18);
  border-radius: 8px;
  padding: 10px 18px;
  color: #C4AFB5;
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 13px;
  font-style: italic;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: border-color 240ms, color 240ms, box-shadow 240ms;
}
.settings-pathbtn:hover {
  border-color: #E5B8C5;
  color: #F4E8EA;
  box-shadow: 0 0 14px rgba(229, 184, 197, 0.2);
}

.settings-danger {
  align-self: start;
  background: transparent;
  border: 1px solid rgba(201, 106, 122, 0.3);
  border-radius: 999px;
  padding: 10px 22px;
  color: #D4889A;
  font-family: var(--display-font, 'Fraunces'), serif;
  font-style: italic;
  font-size: 14px;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: border-color 240ms, color 240ms, box-shadow 240ms;
}
.settings-danger:hover {
  border-color: rgba(201, 106, 122, 0.7);
  color: #E5B0BD;
  box-shadow: 0 0 16px rgba(201, 106, 122, 0.2);
}


