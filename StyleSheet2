.modal-body {
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.modal-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.modal-field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
.modal-label {
  font-family: var(--display-font, 'Fraunces'), serif;
  font-size: 13px;
  font-style: italic;
