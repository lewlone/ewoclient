/* ════════════════════════════════════════════════════════════════
   New Instance modal
   ════════════════════════════════════════════════════════════════ */
.modal-shroud {
  position: absolute;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse at center,
    rgba(8, 2, 6, 0.55) 0%,
    rgba(8, 2, 6, 0.85) 100%);
  /* 8px → 4px: the dim gradient already separates modal foreground from
     background; the 8px blur was adding unreadability without separation
     value. Lighter blur keeps the boudoir feel without obliterating the
     scene for the duration of the modal. */
  backdrop-filter: blur(4px) saturate(0.85);
  -webkit-backdrop-filter: blur(4px) saturate(0.85);
  animation: modal-shroud-in 160ms cubic-bezier(0.22, 1, 0.36, 1) both;
  padding: 40px;
}
@keyframes modal-shroud-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.modal-card {
  position: relative;
  width: min(560px, 100%);
  max-height: calc(100% - 60px);
  border-radius: 22px;
  overflow: visible;
  isolation: isolate;
  /* Card open: 480 → 240ms. The 480ms duration combined with a 10px blur-in
     filter that resolves during the same window made the modal feel "still
     loading" for the user; 240ms keeps the silken curve readable while
     halving the perceived delay. The blur start value is also reduced
     (10 → 6) so by the 50% mark the text is already legible. */
  animation: modal-card-in 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
  box-shadow:
    0 32px 80px rgba(0, 0, 0, 0.55),
    0 8px 28px rgba(0, 0, 0, 0.4),
    0 0 60px rgba(180, 116, 145, 0.12),
    inset 0 0 0 0.5px rgba(229, 184, 197, 0.18);
}
@keyframes modal-card-in {
  /* No filter:blur — translate + scale + opacity is enough motion for the
     entrance, and a CSS filter forces every glyph inside the card to be
     re-rasterized through the blur for the entire animation duration,
     which read as "the modal is still loading" for ~150ms after click. */
  from { opacity: 0; transform: translateY(10px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0)    scale(1);    }
}
.modal-glass-refract {
  position: absolute; inset: 0;
  border-radius: inherit;
  backdrop-filter: blur(40px) saturate(1.5);
  -webkit-backdrop-filter: blur(40px) saturate(1.5);
  background: linear-gradient(180deg,
    rgba(38, 18, 30, 0.92) 0%,
    rgba(28, 12, 22, 0.95) 100%);
  z-index: 0;
}
.modal-glass-tint {
  position: absolute; inset: 0;
  border-radius: inherit;
  background:
    linear-gradient(135deg,
      rgba(229, 184, 197, 0.10) 0%,
      rgba(180, 116, 145, 0.06) 40%,
      rgba(201, 165, 212, 0.10) 100%),
    radial-gradient(140% 80% at 50% -20%, rgba(244, 232, 234, 0.14), transparent 60%);
  z-index: 1;
  pointer-events: none;
}
.modal-inner {
