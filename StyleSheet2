  font-family: var(--body-font, 'Newsreader'), serif;
  font-style: italic;
  font-size: 12px;
  color: #6B555C;
  letter-spacing: 0.02em;
}
.modal-ramrow {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18px;
  align-items: center;
