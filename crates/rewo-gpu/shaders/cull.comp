#version 450
// M5 GPU-driven culling: one invocation per column. Frustum-test the
// column AABB; survivors append a VkDrawIndexedIndirectCommand to the
// indirect buffer and bump the draw count. The CPU then issues a single
// vkCmdDrawIndexedIndirectCount.

layout(local_size_x = 64) in;

struct ColumnMeta {
    vec4 aabb_min;   // xyz world-space + pad
    vec4 aabb_max;
    uint index_count;
    uint first_index;
    int  vertex_offset;
    uint pad;
};

// VkDrawIndexedIndirectCommand: indexCount, instanceCount, firstIndex,
// vertexOffset (int), firstInstance.
struct DrawCmd {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0, std430) readonly buffer Meta { ColumnMeta cols[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Cmds { DrawCmd cmds[]; };
layout(set = 0, binding = 2, std430) buffer Count { uint draw_count; };

layout(push_constant) uniform PC {
    vec4 planes[6];  // frustum planes (Gribb-Hartmann), world space
    uint column_count;
} pc;

bool visible(vec3 mn, vec3 mx) {
    for (int i = 0; i < 6; i++) {
        vec4 p = pc.planes[i];
        // Positive vertex: the AABB corner furthest along the plane normal.
        vec3 pv = vec3(
            p.x >= 0.0 ? mx.x : mn.x,
            p.y >= 0.0 ? mx.y : mn.y,
            p.z >= 0.0 ? mx.z : mn.z
        );
        if (dot(p.xyz, pv) + p.w < 0.0) {
            return false;
        }
    }
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.column_count) {
        return;
    }
    ColumnMeta c = cols[i];
    if (c.index_count == 0u) {
        return;
    }
    if (!visible(c.aabb_min.xyz, c.aabb_max.xyz)) {
        return;
    }
    uint slot = atomicAdd(draw_count, 1u);
    cmds[slot] = DrawCmd(c.index_count, 1u, c.first_index, c.vertex_offset, 0u);
}
